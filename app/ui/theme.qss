/* Light theme, loaded once at startup. Hex values kept in sync by hand
   with app/ui/palette.py. Dark theme is a planned second stylesheet plus
   a View > Theme toggle, added later once this one is solid. */

QWidget {
    background-color: #f5f4f2;
    color: #232220;
    font-size: 13px;
}

QMainWindow {
    background-color: #f5f4f2;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d8d5d0;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #eae8e4;
    border-radius: 3px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d8d5d0;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #eae8e4;
}

QMenu::item:disabled {
    color: #b3b0ac;
}

QDockWidget {
    font-weight: 600;
}

QDockWidget::title {
    background-color: #eae8e4;
    border-bottom: 1px solid #d8d5d0;
    padding: 5px 8px;
}

QLabel#placeholderLabel {
    color: #6b6864;
    font-size: 14px;
    padding: 24px;
}

QLabel#placeholderTitle {
    color: #232220;
    font-size: 16px;
    font-weight: 600;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d8d5d0;
    border-radius: 4px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #eae8e4;
}

QPushButton:disabled {
    color: #b3b0ac;
}

QPushButton#primaryButton {
    background-color: #3d6b52;
    color: #ffffff;
    border: none;
}

QPushButton#primaryButton:hover {
    background-color: #325a45;
}

QTreeView, QListView {
    background-color: #ffffff;
    border: 1px solid #d8d5d0;
    alternate-background-color: #f5f4f2;
}

QTextEdit, QLineEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #d8d5d0;
    border-radius: 3px;
    padding: 4px;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #d8d5d0;
    border-radius: 3px;
    padding: 3px 6px;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d8d5d0;
}

QTabBar::tab {
    background-color: #eae8e4;
    padding: 6px 12px;
    border: 1px solid #d8d5d0;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #ffffff;
}

QDialog {
    background-color: #f5f4f2;
}
